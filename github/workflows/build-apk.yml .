name: Build Tahadiyat Hassan APK

on:
  workflow_dispatch:
  push:
    paths:
      - 'Tahadiyat_Hassan_Full.zip'
      - '.github/workflows/build-apk.yml'

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Extract project
        run: |
          unzip -o Tahadiyat_Hassan_Full.zip -d project
          find project -type f \( -name settings.gradle -o -name settings.gradle.kts \)

      - name: Build APK
        run: |
          ANDROID_DIR=$(dirname "$(find project -type f \( -name settings.gradle -o -name settings.gradle.kts \) | head -n 1)")
          if [ -z "$ANDROID_DIR" ]; then
            echo "Android Gradle project not found"
            exit 1
          fi
          gradle -p "$ANDROID_DIR" assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Tahadiyat-Hassan-APK
          path: project/**/build/outputs/apk/debug/*.apk
          if-no-files-found: error
